# Copy this file to .env and add keys only on your local machine. Do not commit .env.
# Claude is preferred for independent verification. If it is unavailable, Puchoo
# verifies with the configured Groq account instead.
ANTHROPIC_API_KEY=
ANTHROPIC_VERIFIER_MODEL=claude-haiku-4-5-20251001

# Local English-only planning and Text-to-SQL model. The same Qwen chat endpoint
# is called sequentially for complex-query planning, SQL generation, and repair.
PUCHOO_SQL_PROVIDER=groq
GROQ_API_KEY=
GROQ_PLANNER_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# Optional: use a different Groq model for answer verification.
GROQ_VERIFIER_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MAX_TOKENS=1800
PUCHOO_AUTONOMOUS_MODE=true
LOCAL_SQL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_SQL_MODEL_NAME=your-finetuned-qwen-sql-7b
LOCAL_SQL_REQUEST_STYLE=chat
LOCAL_SQL_MAX_ATTEMPTS=2
LOCAL_SQL_MAX_TOKENS=450
LOCAL_SQL_SCHEMA_MAX_TABLES=6
LOCAL_SQL_SCHEMA_MAX_CHARS=12000

# Gnani (Vachana) speech-to-text and text-to-speech. Voice recordings and the
# answer text read aloud are sent to Gnani. GNANI_STT_LANGUAGE is the fallback
# transcription language when the browser does not send one; it must be one of
# en-IN, hi-IN, bn-IN, gu-IN, kn-IN, ml-IN, mr-IN, pa-IN, ta-IN, te-IN
# (the Gnani STT REST API has no "auto" option).
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN

# Accounts. SQLite is the local default; Postgres can replace this URL later.
# Run commands from the repository root so this relative path resolves.
DATABASE_URL=sqlite:///./backend/puchoo_auth.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true when ENVIRONMENT=production (the server refuses to start otherwise).
COOKIE_SECURE=false
ENVIRONMENT=development
SESSION_SECRET=replace-with-a-long-random-string
# HMAC key for login codes. Required when ENVIRONMENT=production.
# Do not leave this placeholder in production.
OTP_SECRET=replace-with-a-long-random-string
# Abuse-control thresholds. Values are counts per configured time window.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
AUTH_BACKOFF_BASE_SECONDS=60
AUTH_BACKOFF_MAX_SECONDS=900
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW_SECONDS=60
AUTHENTICATED_RATE_LIMIT=300
AUTHENTICATED_RATE_WINDOW_SECONDS=60
CONNECTION_RATE_LIMIT=5
CONNECTION_RATE_WINDOW_SECONDS=900
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES=10
# Spreadsheet/CSV import limits (checked before and while parsing).
# Max total uncompressed size of an XLSX archive, in bytes (200 MB).
UPLOAD_XLSX_MAX_UNCOMPRESSED_BYTES=209715200
# Max uncompressed:compressed ratio for an XLSX (zip bomb protection).
UPLOAD_XLSX_MAX_COMPRESSION_RATIO=100
UPLOAD_MAX_SHEETS=50
# Per sheet / per CSV file.
UPLOAD_MAX_ROWS=1000000
UPLOAD_MAX_COLUMNS=500
# Across all sheets and files in one upload.
UPLOAD_MAX_CELLS=10000000
# Open notification (SSE) streams allowed per user; extra ones get HTTP 429.
NOTIFICATION_STREAMS_PER_USER=3
# Query safety. Generated SQL runs only after the user approves it.
# Ceiling for one query, in seconds (workspace settings can only lower it).
QUERY_STATEMENT_TIMEOUT_SECONDS=15
# Ceiling for returned rows; larger results are cut and flagged as truncated.
QUERY_MAX_ROWS=5000
# How long generated SQL waits for approval, in seconds.
PENDING_QUERY_TTL_SECONDS=600
# Connect data sources with a dedicated read-only database user (SELECT only,
# no superuser/FILE/pg_read_server_files). Puchoo.si also forces read-only
# transactions, but least privilege on the database is the strongest control.
# Comma-separated hostnames or IPs that may be private or loopback.
# Leave empty unless a local database is intentionally on a private address.
ALLOWED_DB_HOSTS=
# Workspace database connections require TLS unless this is false.
# Turn it off only for a local database that does not speak TLS.
DB_SSL_REQUIRED=true
# Postgres TLS mode used when DB_SSL_REQUIRED is true.
# Checked once when the API process starts: require or verify-ca.
# require encrypts the session. verify-ca also checks the certificate
# against DB_SSL_ROOT_CERT. verify-full cannot be used: the driver connects
# to the resolved IP, so the certificate name will not match.
DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=
# PEM CA bundle for MySQL server certificates. Leave unset to use certifi.
# Amazon RDS, Aiven, and Google Cloud SQL need DB_SSL_CA set to the
# provider's CA bundle.
# DB_SSL_CA=

# Login emails a 6-digit code through these SMTP settings.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# A verified no-reply mailbox is recommended (for example no-reply@your-domain).
# It must be authorized by your SMTP provider and align with SPF/DKIM/DMARC.
# Leave empty to use SMTP_USERNAME in local development.
SMTP_FROM=
SMTP_FROM_NAME=Puchoo.si no-reply
# Gmail uses STARTTLS on 587. For implicit TLS (usually port 465), set SSL=true and TLS=false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
