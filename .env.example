# Copy this file to .env and add keys only on your local machine. Do not commit .env.
# Claude Sonnet 5 generates read-only SQL; Claude Haiku 4.5 independently verifies it.
ANTHROPIC_API_KEY=
ANTHROPIC_SQL_MODEL=claude-sonnet-5
ANTHROPIC_VERIFIER_MODEL=claude-haiku-4-5-20251001

# Sarvam powers optional Indian-language voice input and answer localisation.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
