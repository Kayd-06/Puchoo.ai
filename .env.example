# Copy this file to .env and add keys only on your local machine. Do not commit .env.
# Claude Haiku independently verifies completed query results.
ANTHROPIC_API_KEY=
ANTHROPIC_VERIFIER_MODEL=claude-haiku-4-5-20251001

# Local English-only Text-to-SQL model. Any local OpenAI-compatible server works.
# For the default Qwen/MLX setup, use request style "chat" and the chat endpoint.
PUCHOO_SQL_PROVIDER=local
LOCAL_SQL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_SQL_MODEL_NAME=mlx-community/Qwen2.5-Coder-7B-Instruct-4bit
LOCAL_SQL_REQUEST_STYLE=chat
LOCAL_SQL_MAX_ATTEMPTS=3
# SQL statements are usually short; a lower cap makes local generation faster.
LOCAL_SQL_MAX_TOKENS=220

# Optional second local model. When Qwen's proposal is rejected, Puchoo sends
# its repair attempt to this SQL-specialist server instead. Leave the URL empty
# to use Qwen alone.
LOCAL_SQL_REPAIR_MODEL_URL=
LOCAL_SQL_REPAIR_MODEL_NAME=defog/sqlcoder-7b-2
LOCAL_SQL_REPAIR_REQUEST_STYLE=completion

# Reserved for a later multilingual voice/translation release.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
