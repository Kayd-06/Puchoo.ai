# Copy to backend/.env. Values already set in the process environment win.
# SQLite is the local default. Point DATABASE_URL at Postgres when you have it.
DATABASE_URL=sqlite:///./backend/puchoo_auth.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
ENVIRONMENT=development
# Used by the analytics session middleware. Replace outside local development.
SESSION_SECRET=replace-with-a-long-random-string
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional display address. Leave empty to use SMTP_USERNAME.
SMTP_FROM=
# Gmail uses STARTTLS on 587. For implicit TLS (usually port 465), set SSL=true and TLS=false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
