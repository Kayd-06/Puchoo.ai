# Copy to backend/.env. Values already set in the process environment win.
# SQLite is the local default. Point DATABASE_URL at Postgres when you have it.
DATABASE_URL=sqlite:///./backend/puchoo_auth.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
ENVIRONMENT=development
# Used by the analytics session middleware. Replace outside local development.
SESSION_SECRET=replace-with-a-long-random-string
# HMAC key for login codes. Required when ENVIRONMENT=production.
OTP_SECRET=replace-with-a-long-random-string
# Private or loopback database hosts are blocked unless listed here.
ALLOWED_DB_HOSTS=
# Set to false only for a local database that does not speak TLS.
DB_SSL_REQUIRED=true
# Postgres TLS mode when DB_SSL_REQUIRED is true: require or verify-ca.
# verify-full cannot be used because connections use the resolved IP.
DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=
# DB_SSL_CA=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# A verified no-reply mailbox is recommended (for example no-reply@your-domain).
# It must be authorized by your SMTP provider and align with SPF/DKIM/DMARC.
# Leave empty to use SMTP_USERNAME in local development.
SMTP_FROM=
# Gmail uses STARTTLS on 587. For implicit TLS (usually port 465), set SSL=true and TLS=false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
